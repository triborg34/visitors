generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// کاربران سیستم (مدیر / کارمند غرفه)
model User {
  id                  String       @id @default(cuid())
  username            String       @unique
  fullName            String
  phone               String?
  email               String?
  passwordHash        String
  role                String       @default("EMPLOYEE")
  isActive            Boolean      @default(true)
  mustChangePassword  Boolean      @default(false)
  lastLoginAt         DateTime?
  activeExhibitionId  String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  activeExhibition    Exhibition?  @relation("ActiveExhibition", fields: [activeExhibitionId], references: [id], onDelete: SetNull)
  registeredVisits    Visit[]      @relation("VisitEmployee")
  assignedVisits      Visit[]      @relation("VisitAssignee")
  followUps           FollowUp[]   @relation("FollowUpAssignee")
  createdFollowUps    FollowUp[]   @relation("FollowUpCreator")
  messageLogs         MessageLog[] @relation("MessageLogCreator")
  auditLogs           AuditLog[]   @relation("AuditLogUser")
  messagingTests      MessagingConnection[] @relation("MessagingConnectionTester")

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

/// نمایشگاه‌ها
model Exhibition {
  id          String    @id @default(cuid())
  name        String
  location    String?
  startDate   DateTime
  endDate     DateTime
  description String?
  status      String    @default("UPCOMING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  visits      Visit[]
  activeUsers User[]   @relation("ActiveExhibition")

  @@index([status])
  @@index([deletedAt])
  @@map("exhibitions")
}

/// هویت بازدیدکننده (هر شخص یک رکورد؛ مراجعات متعدد در Visit)
model Visitor {
  id        String    @id @default(cuid())
  fullName  String
  gender    String    @default("UNKNOWN")
  company   String?
  mobile    String    @unique
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visits    Visit[]

  @@index([fullName])
  @@index([company])
  @@index([deletedAt])
  @@map("visitors")
}

/// هر مراجعه/ثبت در نمایشگاه
model Visit {
  id                 String    @id @default(cuid())
  visitorId          String
  exhibitionId       String
  employeeId         String
  requestType        String
  priority           String    @default("NORMAL")
  notes              String?
  sendThankYou       Boolean   @default(false)
  preferredPlatform  String?
  marketingConsent   Boolean   @default(false)
  consentAt          DateTime?
  consentContext     String?
  followUpStatus     String    @default("NEW")
  assignedEmployeeId String?
  visitDate          DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  visitor          Visitor      @relation(fields: [visitorId], references: [id])
  exhibition       Exhibition   @relation(fields: [exhibitionId], references: [id])
  employee         User         @relation("VisitEmployee", fields: [employeeId], references: [id])
  assignedEmployee User?        @relation("VisitAssignee", fields: [assignedEmployeeId], references: [id])
  followUps        FollowUp[]
  messageLogs      MessageLog[]

  @@index([exhibitionId])
  @@index([employeeId])
  @@index([followUpStatus])
  @@index([priority])
  @@index([requestType])
  @@index([marketingConsent])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("visits")
}

/// سوابق پیگیری مشتری
model FollowUp {
  id                 String    @id @default(cuid())
  visitId            String
  status             String
  note               String?
  lastContactAt      DateTime?
  nextFollowUpAt     DateTime?
  assignedEmployeeId String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  visit            Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  assignedEmployee User? @relation("FollowUpAssignee", fields: [assignedEmployeeId], references: [id])
  createdBy        User? @relation("FollowUpCreator", fields: [createdById], references: [id])

  @@index([visitId])
  @@index([nextFollowUpAt])
  @@index([status])
  @@map("follow_ups")
}

/// قالب‌های پیام
model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  body      String
  platform  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("message_templates")
}

/// تاریخچه پیام‌ها (آماده‌سازی / باز شدن / تأیید ارسال)
model MessageLog {
  id                String   @id @default(cuid())
  visitId           String
  visitorId         String
  platform          String
  templateKey       String?
  body              String
  status            String
  error             String?
  providerMessageId String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visit     Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdBy User? @relation("MessageLogCreator", fields: [createdById], references: [id])

  @@index([visitId])
  @@index([status])
  @@index([createdAt])
  @@map("message_logs")
}

/// تنظیمات شرکت (تک‌رکوردی)
model CompanySettings {
  id                String   @id @default("default")
  companyName       String   @default("امن‌آفرینان")
  description       String?
  website           String?
  phone             String?
  email             String?
  logoUrl           String?
  catalogUrl        String?
  defaultPlatform   String   @default("WHATSAPP")
  updatedAt         DateTime @updatedAt
  updatedById       String?

  @@map("company_settings")
}

/// گزارش عملیات حساس مدیریتی
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user      User?    @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// نتیجهٔ آزمایش اتصال به هر پیام‌رسان (توسط مدیر روی دستگاه واقعی)
model MessagingConnection {
  id           String   @id @default(cuid())
  platform     String   @unique
  status       String   @default("UNTESTED")
  apiToken     String?
  botId        String?
  note         String?
  linkTemplate String?
  testedById   String?
  testedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testedBy     User?    @relation("MessagingConnectionTester", fields: [testedById], references: [id])

  @@index([status])
  @@map("messaging_connections")
}

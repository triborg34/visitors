# ---------------------------------------------------------------------------
# نمونه تنظیمات محیطی — این فایل را به server/.env کپی کنید
# cp .env.example server/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# پایگاه داده SQLite (مسیر نسبی نسبت به پوشه prisma/ محاسبه می‌شود)
DATABASE_URL=file:./dev.db

# کلید امضای JWT — حتماً در محیط production تغییر دهید (حداقل ۳۲ کاراکتر)
JWT_SECRET=change-this-to-a-long-random-secret-string-please
JWT_EXPIRES_IN=8h

# نام و تنظیمات کوکی
COOKIE_NAME=amn_token
CSRF_COOKIE_NAME=amn_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# محدودیت نرخ درخواست
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
API_RATE_LIMIT=600
API_RATE_WINDOW_MINUTES=15

# حساب مدیر اولیه (در اجرای npm run db:seed ساخته می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=مدیر سیستم

# اطلاعات پیش‌فرض شرکت
COMPANY_NAME=امن‌آفرینان
CATALOG_URL=https://amnafarinan.ir/catalog.pdf
